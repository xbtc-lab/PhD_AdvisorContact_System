# ==============================================================================
# PhD Cue / PhD_AdvisorContact_System V3.2 - Environment Variables Example
# Copy this file to `.env` for local development. Never commit `.env`.
# ==============================================================================

# --- Database (PostgreSQL 17 + pgvector One-DB via Docker / WSL Docker) ---
# 国内网络默认走 DaoCloud 镜像加速；海外或 CI 环境可取消下一行注释覆盖为官方镜像
# POSTGRES_IMAGE=pgvector/pgvector:pg17
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=phd_advisor_v2
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/phd_advisor_v2
PUBLIC_BASE_URL=http://127.0.0.1:8788

# --- Security & Server-Side Credential Encryption ---
# 32-byte hex or base64 secret for AES-256-GCM encrypting mailbox passwords / tokens
APP_ENCRYPTION_KEY=

# --- Local Service Ports ---
WEB_PORT=5173
CLOUD_CORE_PORT=8787
WORKER_API_PORT=8788

# --- AI Gateway / Model Config (Managed in cloud-core) ---
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# --- Admin Prompt Management ---
# 本地开发不填则自动生成并持久化到 storage/.dev-admin.token；生产环境务必显式配置高强度随机串
# ADMIN_API_TOKEN=

# --- Phase 3 Commercialization & Auth (Reserved) ---
# BETTER_AUTH_SECRET=replace-with-random-auth-secret
# BETTER_AUTH_URL=http://127.0.0.1:8787

# --- Optional: Outlook / Microsoft 365 OAuth2 (Reserved) ---
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# --- Optional: Object Storage S3/OSS for Resumes & Attachments (Reserved) ---
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Optional: Managed Scraping Fallback (Reserved) ---
# FIRECRAWL_API_KEY=
