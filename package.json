{
  "name": "phd-advisor-contact-v2",
  "private": true,
  "version": "2.0.0-alpha.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently -n cloud,worker,web -c cyan,green,magenta \"pnpm dev:cloud\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:cloud": "pnpm --filter @app/cloud-core dev",
    "dev:worker": "pnpm --filter @app/worker-api dev",
    "dev:web": "pnpm --filter @app/web dev",
    "build": "pnpm --filter @app/shared build && pnpm --filter @app/db build && pnpm --filter @app/cloud-core build && pnpm --filter @app/worker-api build && pnpm --filter @app/web build",
    "typecheck": "pnpm -r typecheck",
    "db:up": "node scripts/docker-compose.mjs up -d",
    "db:down": "node scripts/docker-compose.mjs down",
    "db:logs": "node scripts/docker-compose.mjs logs -f postgres",
    "db:ps": "node scripts/docker-compose.mjs ps"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  }
}
